# Personal Gateway Plus 后端配置示例
# 复制为 .env 并填入真实值；.env 文件已被 .gitignore 排除，不要提交。

# API Key 加密主密钥（32 字节十六进制，共 64 个字符）。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 留空时服务会用进程内随机密钥启动（重启后已加密的 Key 无法解密），仅供本地调试。
GATEWAY_MASTER_KEY=

# 服务监听
HOST=127.0.0.1
PORT=8000

# SQLite 数据库文件路径（相对 server/ 目录）
DATABASE_PATH=data/gateway.db

# 整次请求总超时（秒），防止无限重试
REQUEST_TOTAL_TIMEOUT_SECONDS=30

# 单上游连接/读取超时（秒）
UPSTREAM_TIMEOUT_SECONDS=15

# 跨域：Web 管理端地址，多个用逗号分隔。本地默认允许全部。
CORS_ORIGINS=*
